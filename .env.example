# ── Required ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# ── Optional (app degrades gracefully without this) ─────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Server ──────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=INFO
